# Scheme Saathi — Docker Compose Environment Configuration
# Copy this file to .env before running docker-compose if you wish to override default variables.

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scheme_saathi
POSTGRES_PORT=5433

# Backend Configuration
APP_ENV=development
DEBUG=true
BACKEND_PORT=8000
SECRET_KEY=scheme-saathi-production-docker-secret-key-32chars
JWT_SECRET=scheme-saathi-production-docker-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External AI & Storage Integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Automated Database Initialization
RUN_MIGRATIONS=true
AUTO_SEED_SCHEMES=true

# Frontend Configuration
FRONTEND_PORT=3000
