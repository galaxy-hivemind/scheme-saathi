# ─────────────────────────────────────────────
# Scheme Saathi — Backend Environment Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development
APP_NAME="Scheme Saathi API"
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Server ───────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database (PostgreSQL) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheme_saathi
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Supabase ─────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# CAUTION: Never expose service role key to frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google Gemini ─────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File storage ─────────────────────────────
STORAGE_BUCKET=user-documents
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# ── OCR ──────────────────────────────────────
# Path to Tesseract binary (if using local Tesseract)
# TESSERACT_CMD=/usr/bin/tesseract

# ── Rate limiting ─────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AGENT_RATE_LIMIT_PER_MINUTE=20

# ── Background jobs ───────────────────────────
JOBS_ENABLED=true
